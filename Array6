#include <stdio.h>

int main(void)
{
    int arr[100];
    int n, i, j, temp;
    int candidate, frequency = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n <= 0 || n > 100)
    {
        printf("Please enter a number from 1 to 100.\n");
        return 1;
    }

    printf("Enter elements:\n");

    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    /* Sort the array in ascending order */
    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - i - 1; j++)
        {
            if (arr[j] > arr[j + 1])
            {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    candidate = arr[n / 2];

    for (i = 0; i < n; i++)
    {
        if (arr[i] == candidate)
        {
            frequency++;
        }
    }

    if (frequency > n / 2)
    {
        printf("Majority element = %d\n", candidate);
        printf("Frequency = %d\n", frequency);
    }
    else
    {
        printf("Majority element does not exist.\n");
    }

    return 0;
}
