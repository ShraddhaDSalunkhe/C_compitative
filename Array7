#include <stdio.h>

int main()
{
    int arr[100], n;
    int i, j;
    int maxLength = 0, start = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    for(i = 0; i < n; i++)
    {
        int length = 1;
        int current = arr[i];
        int found;

        /* Check if current number is the start */
        found = 0;

        for(j = 0; j < n; j++)
        {
            if(arr[j] == current - 1)
            {
                found = 1;
                break;
            }
        }

        if(found == 0)
        {
            while(1)
            {
                found = 0;

                for(j = 0; j < n; j++)
                {
                    if(arr[j] == current + 1)
                    {
                        found = 1;
                        break;
                    }
                }

                if(found == 0)
                    break;

                current++;
                length++;
            }

            if(length > maxLength)
            {
                maxLength = length;
                start = arr[i];
            }
        }
    }

    printf("\nLongest consecutive sequence:\n");

    for(i = 0; i < maxLength; i++)
        printf("%d ", start + i);

    printf("\nLength = %d\n", maxLength);

    return 0;
}
