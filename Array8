#include <stdio.h>

int main()
{
    int arr[100], n;
    int i, j;
    int count, frequency = 0;
    int candidate;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    /* Find candidate */
    count = 0;

    for(i = 0; i < n; i++)
    {
        if(count == 0)
        {
            candidate = arr[i];
            count = 1;
        }
        else if(arr[i] == candidate)
            count++;
        else
            count--;
    }

    /* Count candidate */
    for(i = 0; i < n; i++)
    {
        if(arr[i] == candidate)
            frequency++;
    }

    if(frequency > n / 2)
    {
        printf("Majority element = %d\n", candidate);
        printf("Frequency = %d\n", frequency);
    }
    else
        printf("Majority element does not exist.\n");

    return 0;
}
