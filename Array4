#include <stdio.h>

int main()
{
    int arr[100];
    int n, i, j;
    int count, majority = 0;
    int frequency = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");

    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    for(i = 0; i < n; i++)
    {
        count = 0;

        for(j = 0; j < n; j++)
        {
            if(arr[i] == arr[j])
            {
                count++;
            }
        }

        if(count > n / 2)
        {
            majority = arr[i];
            frequency = count;
            break;
        }
    }

    if(frequency > 0)
    {
        printf("Majority element = %d\n", majority);
        printf("Frequency = %d\n", frequency);
    }
    else
    {
        printf("Majority element does not exist.\n");
    }

    return 0;
}
